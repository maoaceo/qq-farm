# Copy to .env for Docker Compose; never commit real credentials.
PORT=3007
TZ=Asia/Shanghai
NODE_ENV=production
AUTH_PUBLIC_URL=https://farm.example.com
# Explicit opt-in: first successful identity-provider login creates a normal user.
OIDC_AUTO_REGISTER=false
# Google Web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional second, standards-compliant OIDC provider (RS256/ES256, PKCE S256)
OIDC_NAME=OIDC
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Generic OIDC compatibility (Google always keeps PKCE enabled)
OIDC_SCOPES=openid profile
OIDC_PKCE=true
OIDC_TOKEN_AUTH_METHOD=auto
# Yaohuo: OIDC_ISSUER=https://yaohuo.me, OIDC_NAME=妖火
# Yaohuo confidential client: OIDC_PKCE=false, OIDC_TOKEN_AUTH_METHOD=client_secret_post

# Local username/password self-registration (disable with false)
LOCAL_REGISTRATION_ENABLED=true
